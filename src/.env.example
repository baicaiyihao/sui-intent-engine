# QuantCore / sui-intent-engine backend environment
# Copy this file to `src/.env` and fill in the values.
#
# Without an LLM key, the AI features (chat, signal, analysis) will be disabled.
# Without the data source (Binance CCXT), the quant backtest will be disabled.
# Trading on DeepBook V3 mainnet does NOT need any env var — it only needs the
# user's connected wallet to be funded with SUI/USDC.

# ========== LLM Provider ==========
# Supported: minimax | openrouter | openai | deepseek | google
LLM_PROVIDER=minimax

# MiniMax  (https://api.minimaxi.com — note: 6 letters, not "minimax")
MINIMAX_API_KEY=<your-minimax-key>
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Alternative: OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative: DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Alternative: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ========== Data Source (CCXT) ==========
DEFAULT_EXCHANGE=binance
TESTNET=true

# Optional: SOCKS/HTTP proxy for CCXT requests (Clash default: 7890)
# CCXT_PROXY=http://127.0.0.1:7890
